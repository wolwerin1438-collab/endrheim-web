---
import '../styles/global.css';
import DagazMark from '../components/DagazMark.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props { title?: string; description?: string; lang?: string }
const {
  title,
  description = 'Endrheim is a curated Skyrim Special Edition modlist, installed with Wabbajack.',
  lang = 'en',
} = Astro.props;
const fullTitle = title ? `${title} – Endrheim` : 'Endrheim – the world, reborn';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/mods', label: 'Mod list' },
  { href: '/about', label: 'About and credits' },
];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <meta name="color-scheme" content="dark light" />
  <script is:inline>
    try {
      const t = localStorage.getItem('theme');
      if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
    } catch {}
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap bar">
      <a class="brand" href="/" aria-label="Endrheim home">
        <DagazMark size={40} />
        <span class="brand-name">Endrheim</span>
      </a>
      <nav aria-label="Main">
        <ul>
          {nav.map((item) => (
            <li><a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap foot">
      <DagazMark size={28} ring={false} dot={false} />
      <p>
        Endrheim is a fan-made modlist curated by <a href="https://www.nexusmods.com/profile/wolfik1438" rel="noopener">wolfik1438</a>. Every mod belongs to its author; the list credits each one.
        The Elder Scrolls, Skyrim and Bethesda are trademarks of their respective owners. This project is not affiliated with or endorsed by them.
      </p>
      <p class="small">Site code under the MIT licence. Endrheim name, logo, texts, screenshots and videos © wolfik1438, all rights reserved.</p>
    </div>
  </footer>
</body>
</html>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -3rem;
    background: var(--bg-raised);
    padding: 0.5rem 0.75rem;
    z-index: 10;
  }
  .skip:focus { top: 1rem; }

  .site-header { border-bottom: 1px solid var(--rule); }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-block: 0.75rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    margin-right: auto;
    min-height: 44px;
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: 0.14em;
  }
  nav ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  nav a {
    display: inline-block;
    padding-block: 0.6rem;
    text-decoration: none;
    color: var(--ink-muted);
  }
  nav a:hover, nav a[aria-current='page'] { color: var(--ink); }
  nav a[aria-current='page'] { box-shadow: inset 0 -2px 0 var(--accent); }

  .site-footer {
    border-top: 1px solid var(--rule);
    margin-top: 6rem;
    padding-block: 2.5rem 3rem;
    color: var(--ink-muted);
    font-size: var(--step--1);
  }
  .foot { display: grid; gap: 0.75rem; justify-items: start; }
  .foot p { margin: 0; }
  .small { opacity: 0.85; }
</style>
